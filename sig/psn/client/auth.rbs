module PSN
  module Client
    class Auth
      AUTH_URL: String
      DEFAULT_CLIENT_ID: String
      DEFAULT_BASIC_TOKEN: String
      BASIC_TOKEN: String

      def self.authenticate: () -> String
      def authenticate: () -> String

      private

      def fetch_auth_code: () -> String
      def request_auth_code: (URI::Generic) -> Net::HTTPResponse
      def http_for: (URI) -> Net::HTTP
      def request_for: (URI) -> Net::HTTP::Get
      def fetch_token: (String) -> OAuth2::AccessToken
      def token_error: (StandardError) -> Error
      def parse_code: (Net::HTTPResponse) -> String
      def fail_with: (String, Net::HTTPResponse, error_code: String?) -> bot
      def response_error: (String, untyped, error_code: String?) -> Error
      def log_and_raise: (Error) -> bot
      def parse_json: (String?) -> Hash[String, untyped]
      def get_error_message: (String?, ?String) -> String
      def client: () -> OAuth2::Client
      def auth_url: () -> String
      def npsso_cookie: () -> String
    end
  end
end
