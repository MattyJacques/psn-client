module PSN
  module Client
    class Auth
      AUTH_URL: String
      DEFAULT_CLIENT_ID: String
      DEFAULT_BASIC_TOKEN: String
      REDIRECT_URI: String
      SCOPE: String
      TIMEOUT_OPTIONS: Array[Symbol]

      @npsso: String?
      @client_id: String?
      @basic_token: String?
      @timeouts: Hash[Symbol, Numeric]

      def self.authenticate: (?npsso: String?, ?client_id: String?, ?basic_token: String?, ?open_timeout: Numeric?, ?read_timeout: Numeric?, ?write_timeout: Numeric?) -> String
      def self.tokens: (?npsso: String?, ?client_id: String?, ?basic_token: String?, ?open_timeout: Numeric?, ?read_timeout: Numeric?, ?write_timeout: Numeric?) -> Tokens
      def self.refresh: (String refresh_token, ?npsso: String?, ?client_id: String?, ?basic_token: String?, ?open_timeout: Numeric?, ?read_timeout: Numeric?, ?write_timeout: Numeric?) -> Tokens
      def initialize: (?npsso: String?, ?client_id: String?, ?basic_token: String?, ?open_timeout: Numeric?, ?read_timeout: Numeric?, ?write_timeout: Numeric?) -> void
      def authenticate: () -> String
      def tokens: () -> Tokens
      def refresh: (String refresh_token) -> Tokens

      private

      def fetch_auth_code: () -> String
      def request_auth_code: (URI::Generic) -> Net::HTTPResponse
      def http_for: (URI) -> Net::HTTP
      def request_for: (URI) -> Net::HTTP::Get
      def fetch_token: (String) -> OAuth2::AccessToken
      def fetch_refreshed_token: (String) -> OAuth2::AccessToken
      def request_token: (String) { () -> OAuth2::AccessToken } -> OAuth2::AccessToken
      def token_error: (StandardError, String) -> Error
      def parse_code: (Net::HTTPResponse) -> String
      def fail_with: (String, Net::HTTPResponse, error_code: String?) -> bot
      def response_error: (String, untyped, error_code: String?) -> Error
      def log_and_raise: (Error) -> bot
      def parse_json: (String?) -> Hash[String, untyped]
      def get_error_message: (String?, ?String) -> String
      def client: () -> OAuth2::Client
      def auth_url: () -> String
      def npsso_cookie: () -> String
      def client_id: () -> String
      def basic_token: () -> String
    end
  end
end
