module PSN
  module Client
    class Users
      include Pagination

      SEARCH_OPERATION: String
      SEARCH_HASH: String
      SEARCH_CONTEXT: String
      SEARCH_LOCALE: String
      SEARCH_HEADERS: Hash[String, String]
      PROFILE2_PATH: String
      PROFILE2_FIELDS: String
      PROFILE_BY_ACCOUNT_PATH: String
      PLAYED_GAMES_PATH: String
      PLAYED_GAMES_MAX_LIMIT: Integer
      USER_ID_PATTERN: Regexp
      ONLINE_ID_PATTERN: Regexp

      @request: Request

      def initialize: (String access_token) -> void
      def search: (String term) -> untyped
      def account_id: (String online_id) -> String
      def profile: (online_id: String) -> Hash[String, untyped]?
      def profile_by_account_id: (account_id: String) -> untyped
      def played_games: (?user_id: String, ?limit: Integer, ?offset: Integer) -> untyped
    end
  end
end
