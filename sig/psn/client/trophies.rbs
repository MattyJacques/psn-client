module PSN
  module Client
    class Trophies
      include Pagination

      TROPHY_TITLES_MAX_LIMIT: Integer
      USER_ID_PATTERN: Regexp
      NP_COMMUNICATION_ID_PATTERN: Regexp
      TROPHY_GROUP_ID_PATTERN: Regexp

      @request: Request

      def initialize: (?String? access_token, ?request: Request?) -> void
      def trophy_titles: (?user_id: String | Integer, ?limit: Integer, ?offset: Integer) -> untyped
      def trophy_summary: (?user_id: String | Integer) -> untyped
      def title_trophy_groups: (np_communication_id: String, ?np_service_name: String?, ?platform: String?) -> untyped
      def earned_trophy_groups: (?user_id: String | Integer, np_communication_id: String, ?np_service_name: String?, ?platform: String?) -> untyped
      def title_trophies: (np_communication_id: String, ?trophy_group_id: String, ?np_service_name: String?, ?platform: String?, ?limit: Integer?, ?offset: Integer?) -> untyped
      def earned_trophies: (?user_id: String | Integer, np_communication_id: String, ?trophy_group_id: String, ?np_service_name: String?, ?platform: String?, ?limit: Integer?, ?offset: Integer?) -> untyped

      private

      def user: (untyped user_id) -> untyped
      def title: (untyped np_communication_id) -> untyped
      def group: (untyped trophy_group_id) -> untyped
      def segment: (String name, untyped value, Regexp pattern) -> untyped
      def title_params: (String? service_name, String? platform, ?limit: Integer?, ?offset: Integer?) -> Hash[String, String | Integer]
      def resolve_service_name: (String? service_name, String? platform) -> String?
    end
  end
end
