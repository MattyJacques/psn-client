module PSN
  module Client
    class Error < StandardError
      attr_reader status: Integer?
      attr_reader headers: Hash[String, String]
      attr_reader body: String?

      def self.details_from: (Net::HTTPResponse response) -> { status: Integer, headers: Hash[String, String], body: String? }

      def initialize: (?String? message, ?status: Integer?, ?headers: Hash[String, String], ?body: String?) -> void
    end

    class AuthenticationError < Error
      attr_reader error_code: String?

      def initialize: (?String? message, ?error_code: String?, ?status: Integer?, ?headers: Hash[String, String], ?body: String?) -> void
    end

    class PrivacyError < Error
    end

    class RateLimitError < Error
      def retry_at: () -> Time?
    end

    class GraphQLError < Error
      attr_reader errors: Array[untyped]
      attr_reader data: untyped

      def initialize: (?String? message, ?errors: Array[untyped], ?data: untyped, ?status: Integer?, ?headers: Hash[String, String], ?body: String?) -> void
    end

    class TransportError < Error
      NETWORK_ERRORS: Array[Class]
    end

    class ParseError < Error
    end
  end
end
