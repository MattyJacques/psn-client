module PSN
  module Client
    class Request
      HOSTS: Hash[Symbol, String]
      BASE_URL: String
      PRIVACY_PATTERN: Regexp

      def initialize: (String access_token) -> void
      def get: (String path, ?host: Symbol, ?params: Hash[untyped, untyped], ?headers: Hash[String, String]) -> untyped

      private

      def build_uri: (Symbol host, String path, Hash[untyped, untyped] params) -> URI::Generic
      def perform: (URI::Generic uri, Net::HTTPRequest http_request) -> untyped
      def parse_response: (Net::HTTPResponse response) -> untyped
      def privacy_error?: (Net::HTTPResponse response) -> bool
    end
  end
end
